<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#occursAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>occursAt</rdfs:label>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#hasCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasCategory</rdfs:label>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#incidentOnDate">
    <rdfs:domain rdf:resource="http://crimedb.org/ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://crimedb.org/ontology#IncidentDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#hasSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>hasSeverity</rdfs:label>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#incidentOnDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>incidentOnDate</rdfs:label>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#IncidentDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#Severity_High">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://crimedb.org/ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#IncidentDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Incident Date</rdfs:label>
    <rdfs:comment>Temporal occurrence date of an incident</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#CrimeIncident">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Crime Incident</rdfs:label>
    <rdfs:comment>Root entity representing a reported criminal occurrence</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#Severity_Medium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Medium</rdfs:label>
    <rdfs:comment>Medium severity tier</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/crime-ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#Severity_Critical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Critical</rdfs:label>
    <rdfs:comment>Critical severity tier</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/crime-ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#Severity_Critical">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://crimedb.org/ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#Severity_Medium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://crimedb.org/ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#CrimeCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Crime Category</rdfs:label>
    <rdfs:comment>Taxonomy classification of criminal offenses</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#Severity_High">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>High</rdfs:label>
    <rdfs:comment>High severity tier</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/crime-ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#CrimeIncident">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#Severity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Severity Level</rdfs:label>
    <rdfs:comment>Degree of harm or criticality of an incident</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#hasSeverity">
    <rdfs:domain rdf:resource="http://crimedb.org/ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://crimedb.org/ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#Location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Location Entity</rdfs:label>
    <rdfs:comment>Spatial coordinates and jurisdictional regions</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#CrimeCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#IncidentDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#hasCategory">
    <rdfs:domain rdf:resource="http://crimedb.org/ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://crimedb.org/ontology#CrimeCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#Severity_Low">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://crimedb.org/ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#occursAt">
    <rdfs:domain rdf:resource="http://crimedb.org/ontology#CrimeIncident"/>
    <rdfs:range rdf:resource="http://crimedb.org/ontology#Location"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#Severity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/crime-ontology#Severity_Low">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Low</rdfs:label>
    <rdfs:comment>Low severity tier</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/crime-ontology#Severity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://crimedb.org/ontology#Location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
</rdf:RDF>
