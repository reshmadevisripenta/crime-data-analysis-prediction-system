<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/crime-ontology#"
     xml:base="http://www.semanticweb.org/crime-ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:crime="http://www.semanticweb.org/crime-ontology#">

    <!-- Ontology Declaration -->
    <owl:Ontology rdf:about="http://www.semanticweb.org/crime-ontology">
        <dc:title>Crime Data Analysis Prediction System Ontology</dc:title>
        <dc:description>An ontology for representing crime data, analysis results, and predictions</dc:description>
        <dc:creator>Crime Data Analysis Prediction System</dc:creator>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- ============================================================
         CLASS DECLARATIONS
         ============================================================ -->

    <!-- Crime (Top-level class) -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#Crime">
        <rdfs:label>Crime</rdfs:label>
        <rdfs:comment>A top-level class representing a crime or criminal activity.</rdfs:comment>
    </owl:Class>

    <!-- CrimeRecord -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#CrimeRecord">
        <rdfs:label>CrimeRecord</rdfs:label>
        <rdfs:comment>An individual recorded crime incident with specific attributes such as date, location, and category.</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/crime-ontology#Crime"/>
    </owl:Class>

    <!-- CrimeCategory -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#CrimeCategory">
        <rdfs:label>CrimeCategory</rdfs:label>
        <rdfs:comment>A classification or type of crime (e.g., Theft, Assault, Burglary).</rdfs:comment>
    </owl:Class>

    <!-- Location -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#Location">
        <rdfs:label>Location</rdfs:label>
        <rdfs:comment>A geographic location where crime incidents are recorded (city, region, or jurisdiction).</rdfs:comment>
    </owl:Class>

    <!-- DateTime -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#DateTime">
        <rdfs:label>DateTime</rdfs:label>
        <rdfs:comment>A temporal entity representing when a crime occurred, including date and time attributes.</rdfs:comment>
    </owl:Class>

    <!-- PoliceStation -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#PoliceStation">
        <rdfs:label>PoliceStation</rdfs:label>
        <rdfs:comment>A law enforcement facility responsible for a geographic jurisdiction.</rdfs:comment>
    </owl:Class>

    <!-- AnalysisResult -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#AnalysisResult">
        <rdfs:label>AnalysisResult</rdfs:label>
        <rdfs:comment>The output of a data analysis process applied to crime records, including statistics and findings.</rdfs:comment>
    </owl:Class>

    <!-- Prediction -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#Prediction">
        <rdfs:label>Prediction</rdfs:label>
        <rdfs:comment>An aggregate crime trend forecast generated by a trained machine learning model.</rdfs:comment>
    </owl:Class>

    <!-- MLModel -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#MLModel">
        <rdfs:label>MLModel</rdfs:label>
        <rdfs:comment>A machine learning model trained on historical crime data to forecast aggregate crime trends.</rdfs:comment>
    </owl:Class>

    <!-- DatasetUpload -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#DatasetUpload">
        <rdfs:label>DatasetUpload</rdfs:label>
        <rdfs:comment>A dataset file (CSV or Excel) uploaded into the system containing historical crime records.</rdfs:comment>
    </owl:Class>

    <!-- User -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#User">
        <rdfs:label>User</rdfs:label>
        <rdfs:comment>A system user who can upload data, run analyses, and generate predictions.</rdfs:comment>
    </owl:Class>

    <!-- Report -->
    <owl:Class rdf:about="http://www.semanticweb.org/crime-ontology#Report">
        <rdfs:label>Report</rdfs:label>
        <rdfs:comment>A generated document summarizing crime analysis results, trends, or prediction outcomes.</rdfs:comment>
    </owl:Class>

    <!-- ============================================================
         OBJECT PROPERTY DECLARATIONS
         ============================================================ -->

    <!-- hasCategory -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#hasCategory">
        <rdfs:label>hasCategory</rdfs:label>
        <rdfs:comment>Relates a CrimeRecord to its CrimeCategory classification.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeCategory"/>
    </owl:ObjectProperty>

    <!-- occursAt -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#occursAt">
        <rdfs:label>occursAt</rdfs:label>
        <rdfs:comment>Relates a CrimeRecord to the Location where it was recorded.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#Location"/>
    </owl:ObjectProperty>

    <!-- occurredOn -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#occurredOn">
        <rdfs:label>occurredOn</rdfs:label>
        <rdfs:comment>Relates a CrimeRecord to the DateTime when it occurred.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#DateTime"/>
    </owl:ObjectProperty>

    <!-- analyzes -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#analyzes">
        <rdfs:label>analyzes</rdfs:label>
        <rdfs:comment>Relates an AnalysisResult to the CrimeRecord(s) it analyzed.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#AnalysisResult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
    </owl:ObjectProperty>

    <!-- predictsTrendFor -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#predictsTrendFor">
        <rdfs:label>predictsTrendFor</rdfs:label>
        <rdfs:comment>Relates a Prediction to the Location for which aggregate crime trends are forecast.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#Prediction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#Location"/>
    </owl:ObjectProperty>

    <!-- generatedBy -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#generatedBy">
        <rdfs:label>generatedBy</rdfs:label>
        <rdfs:comment>Relates a Prediction to the MLModel that generated it.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#Prediction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#MLModel"/>
    </owl:ObjectProperty>

    <!-- trainedOn -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#trainedOn">
        <rdfs:label>trainedOn</rdfs:label>
        <rdfs:comment>Relates an MLModel to the DatasetUpload used to train it.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#MLModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#DatasetUpload"/>
    </owl:ObjectProperty>

    <!-- isLocatedIn -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#isLocatedIn">
        <rdfs:label>isLocatedIn</rdfs:label>
        <rdfs:comment>Relates a PoliceStation to its Location or jurisdiction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#PoliceStation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#Location"/>
    </owl:ObjectProperty>

    <!-- hasJurisdiction -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#hasJurisdiction">
        <rdfs:label>hasJurisdiction</rdfs:label>
        <rdfs:comment>Relates a PoliceStation to CrimeRecords within its jurisdiction.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#PoliceStation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
    </owl:ObjectProperty>

    <!-- uploadedBy -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#uploadedBy">
        <rdfs:label>uploadedBy</rdfs:label>
        <rdfs:comment>Relates a DatasetUpload to the User who uploaded it.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#DatasetUpload"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#User"/>
    </owl:ObjectProperty>

    <!-- containsRecords -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#containsRecords">
        <rdfs:label>containsRecords</rdfs:label>
        <rdfs:comment>Relates a DatasetUpload to the CrimeRecords parsed from it.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#DatasetUpload"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
    </owl:ObjectProperty>

    <!-- summarizes -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/crime-ontology#summarizes">
        <rdfs:label>summarizes</rdfs:label>
        <rdfs:comment>Relates a Report to the AnalysisResult it summarizes.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#Report"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/crime-ontology#AnalysisResult"/>
    </owl:ObjectProperty>

    <!-- ============================================================
         DATA PROPERTY DECLARATIONS
         ============================================================ -->

    <!-- incidentDate -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#incidentDate">
        <rdfs:label>incidentDate</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <!-- severity -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#severity">
        <rdfs:label>severity</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#CrimeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- latitude -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#latitude">
        <rdfs:label>latitude</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- longitude -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#longitude">
        <rdfs:label>longitude</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- predictedCount -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#predictedCount">
        <rdfs:label>predictedCount</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#Prediction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- rSquared -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#rSquared">
        <rdfs:label>rSquared</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#MLModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- algorithm -->
    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/crime-ontology#algorithm">
        <rdfs:label>algorithm</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/crime-ontology#MLModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

</rdf:RDF>
